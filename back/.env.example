# Скопировать в .env и вписать ключи. Сервис не стартует с пустыми обязательными
# значениями: упасть на старте лучше, чем принять ролик и упасть на стадии structure.

# --- инфраструктура (в docker compose перекрываются на имена сервисов) ---
DATABASE_URL=postgresql+psycopg://sirochek:sirochek@localhost:5432/sirochek
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./data
CORS_ORIGINS=http://localhost:5173

# --- Инференс: провайдеры в порядке предпочтения, первый рабочий отвечает ---
# local — Marlin на этой машине (см. back/local_app/serve.py), modal — облако.
INFERENCE_PROVIDERS=local,modal
# Хост со стороны контейнера. Сервис обязан слушать 0.0.0.0, не loopback.
LOCAL_INFERENCE_URL=http://host.docker.internal:8100

# --- Modal: запасной инференс ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=sirochek-marlin
MODAL_FUNCTION_TIMEOUT_S=180

# --- Языковая модель: стадия structure, деление описания на действие и объект ---
# Годится любой OpenAI-совместимый эндпоинт; ключ идёт в Authorization: Bearer.
# Провайдер — параметр конфигурации, а не имя в коде.
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Имя модели берётся из каталога провайдера (GET {LLM_BASE_URL}/models), не по памяти:
# у каждого своя схема именования. Сравнить другую модель — смена этой переменной.
STRUCTURE_MODEL=openai/gpt-oss-120b
# source — оставить язык, на котором ответила Marlin (она отвечает по-английски);
# ru / en — привести принудительно. Эталон Assembly101 английский.
STRUCTURE_LANG=en

# --- параметры модели: значения по умолчанию — те, на которых Marlin обучался ---
MARLIN_FPS=2.0
MARLIN_MAX_NEW_TOKENS=512
# caption — родной режим модели; json — запасной путь со structured output,
# доступен только если подтвердится совместимость custom_code с vLLM
MARLIN_PROMPT_MODE=caption

# --- лимиты загрузки, их же отдаёт GET /config ---
MIN_DURATION_S=5
MAX_DURATION_S=30
MIN_HEIGHT=720
MAX_UPLOAD_BYTES=209715200

# --- пороги продукта: подбираются замером, не вкусом ---
# ниже этого шаг получает needs_review — интерфейс монохромный и кодирует
# уверенность меткой, а не цветом, поэтому порог считает сервер
CONFIDENCE_THRESHOLD=0.6
# шаги короче схлопываются с соседом на постобработке
MIN_SEGMENT_S=0.4
# похожесть описаний, при которой соседние шаги ПРЕДЛАГАЮТСЯ к слиянию
MERGE_THRESHOLD=0.9
