# Скопировать в .env и вписать ключи. Сервис не стартует с пустыми обязательными
# значениями: упасть на старте лучше, чем принять ролик и упасть на стадии structure.

# --- инфраструктура (в docker compose перекрываются на имена сервисов) ---
DATABASE_URL=postgresql+psycopg://sirochek:sirochek@localhost:5432/sirochek
REDIS_URL=redis://localhost:6379/0
MEDIA_ROOT=./data
CORS_ORIGINS=http://localhost:5173

# --- Modal: там живёт Marlin-2B ---
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=sirochek-marlin
MODAL_FUNCTION_TIMEOUT_S=180

# --- OpenRouter: стадия structure, деление описания на действие и объект ---
# OpenAI-совместимый эндпоинт, ключ идёт в Authorization: Bearer.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Необязательные заголовки атрибуции в их рейтингах:
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=sirochek

# Слаг из каталога OpenRouter (GET /api/v1/models) — с префиксом провайдера и точками,
# не первопартийный id. Выбор ценой, а не качеством: задача — разложить короткую фразу
# по трём полям. Сравнить другую модель — это смена одной этой переменной.
STRUCTURE_MODEL=anthropic/claude-haiku-4.5

# --- параметры модели: значения по умолчанию — те, на которых Marlin обучался ---
MARLIN_FPS=2.0
MARLIN_MAX_NEW_TOKENS=512
# caption — родной режим модели; json — запасной путь со structured output,
# доступен только если подтвердится совместимость custom_code с vLLM
MARLIN_PROMPT_MODE=caption

# --- лимиты загрузки, их же отдаёт GET /config ---
MIN_DURATION_S=5
MAX_DURATION_S=30
MIN_HEIGHT=720
MAX_UPLOAD_BYTES=209715200

# --- пороги продукта: подбираются замером, не вкусом ---
# ниже этого шаг получает needs_review — интерфейс монохромный и кодирует
# уверенность меткой, а не цветом, поэтому порог считает сервер
CONFIDENCE_THRESHOLD=0.6
# шаги короче схлопываются с соседом на постобработке
MIN_SEGMENT_S=0.4
# похожесть описаний, при которой соседние шаги ПРЕДЛАГАЮТСЯ к слиянию
MERGE_THRESHOLD=0.9
